# ------------------------------------------------------------------
# Cafe Finder — environment variables (copy to .env, never commit .env)
# Full reference: docs/ENVIRONMENT.md
# ------------------------------------------------------------------

# Database (MySQL / MariaDB via XAMPP by default).
# Default XAMPP MySQL: user "root", empty password, port 3306.
DATABASE_URL="mysql://root:@localhost:3306/cafe_finder"

# Public base URL of the app (used for metadata / absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Maps / tiles ---
# OpenStreetMap standard raster tiles: genuinely free, no key, no watermark.
# For a cleaner/branded basemap, set a KEYED provider here (MapTiler, Stadia, or
# CARTO with a free account) — those need a token and are opt-in (see docs/MAPS.md).
# NOTE: CARTO's keyless basemaps now watermark ("API KEY REQUIRED"), so they are
# NOT used by default.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# --- Geocoding (manual location search + reverse geocoding) ---
# Nominatim (OpenStreetMap) is used by default. The public instance REQUIRES a
# real, descriptive User-Agent (app name + contact URL or email) and enforces a
# strict ~1 req/sec usage policy. Placeholder/fake-email UAs are rejected (403).
GEOCODER_PROVIDER="nominatim"
GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"
GEOCODER_USER_AGENT="CafeFinder/0.1 (+https://your-domain.example)"

# --- Places data source ---
# "curated" = local seeded dataset (default, free, no external calls).
# Provider abstraction lives in src/lib/places/ so this can become
# "google" | "mapbox" later without touching feature code.
PLACES_PROVIDER="curated"

# --- Auth / admin bootstrap ---
# PRODUCTION: create the admin with `npm run db:create-admin` (the seed does NOT
# create a default admin in prod, and refuses weak passwords). Password must be
# strong: >=12 chars, mix 3 of lower/upper/number/symbol, not a known default.
# DEV: `npm run db:seed` will create an admin from these (warns if weak).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-strong-unique-password"

# --- External enrichment (OPTIONAL, off by default) ---
# Google Places API (New) key for rating/review/photo/hours enrichment.
# PAID: Google Maps Platform uses field-based billing + requires a billing
# account. Leave blank to keep enrichment disabled (ratings stay "unavailable").
# Enable the "Places API (New)" and restrict the key. Server-only — never
# expose as NEXT_PUBLIC_. See docs/DATA-SOURCES.md for fields, cost, attribution.
GOOGLE_MAPS_API_KEY=""

# --- Foursquare Places (OPTIONAL, FREE tier — no credit card) ---
# Real ratings + photos + hours. Create a free developer account at
# https://foursquare.com/developers , make a Places API key, paste it here.
# Verify the current free-tier terms on signup. Server-only.
FOURSQUARE_API_KEY=""
# Force a provider ("google" | "foursquare"); blank = auto (Google if its key is
# set, else Foursquare).
ENRICHMENT_PROVIDER=""
# Foursquare API version date header (defaults to a recent stable value).
FOURSQUARE_API_VERSION="2025-06-17"
